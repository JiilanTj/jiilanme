---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { posts } from '../data/posts';

const recentPosts = posts.slice(0, 3);
---

<Layout
  title="Jiilan Nashrulloh Tanjung — AI-Powered Full-Stack Developer"
  description="AI-powered full-stack developer for web, mobile and business automation. You bring the goal, I ship it."
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jiilan Nashrulloh Tanjung",
    "alternateName": ["Jiilan", "JiilanTj", "Jiilan NT", "Jiilan Tanjung", "Jiilan Nashrulloh"],
    "url": "https://jiilan.me",
    "jobTitle": ["Full-Stack Developer"],
    "knowsAbout": [
      "Web Development",
      "Mobile App Development",
      "Business Automation",
      "AI Integration",
      "React",
      "React Native"
    ],
    "sameAs": [
      "https://github.com/JiilanTj"
    ],
    "email": "jiilannashrulloh@gmail.com"
  })} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Hi, I'm Jiilan — full-stack developer</span>
        <h1 class="hero-title">I build apps and<br />automation that grow business.</h1>
        <p class="hero-sub">AI-powered full-stack developer for web, mobile and business automation. You bring the goal, I ship it.</p>
        <div class="hero-ctas">
          <a href="/works" class="btn-primary">See my work</a>
          <a href="/contacts" class="btn-ghost">Say hello</a>
        </div>
        <div class="hero-meta">
          <span class="pulse" aria-hidden="true"></span>
          <span>Available for new projects</span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="photo-arch">
          <img src="/jiilan.webp" alt="Portrait of Jiilan Nashrulloh Tanjung" width="400" height="400" loading="eager" decoding="async" fetchpriority="high" />
        </div>
        <span class="sticker sticker-a">web</span>
        <span class="sticker sticker-b">mobile</span>
        <span class="sticker sticker-c">AI automation</span>
      </div>
    </div>
  </section>

  <!-- MARQUEE (one per page) -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>web apps · mobile apps · AI automation · landing pages · dashboards · chatbots ·&nbsp;</span>
      <span>web apps · mobile apps · AI automation · landing pages · dashboards · chatbots ·&nbsp;</span>
    </div>
  </div>

  <!-- STATS BENTO -->
  <section class="wrap">
    <div class="stats-grid reveal">
      <div class="stat-card stat-hero">
        <span class="stat-num">5+</span>
        <span class="stat-label">years building software</span>
      </div>
      <div class="stat-card tint-mint">
        <span class="stat-num">10+</span>
        <span class="stat-label">projects and open source</span>
      </div>
      <div class="stat-card tint-sky">
        <span class="stat-num">3</span>
        <span class="stat-label">focus areas: web, mobile, AI</span>
      </div>
      <div class="stat-card tint-peach">
        <span class="stat-num">→</span>
        <span class="stat-label">your project next</span>
      </div>
    </div>
  </section>

  <!-- WHAT I DO -->
  <section class="wrap">
    <div class="doing reveal">
      <div class="doing-head">
        <h2 class="h2">Everything you need to ship.</h2>
        <p class="lede">One developer for your website, your mobile app and the automation in between. No handoffs, no agency overhead.</p>
      </div>
      <div class="doing-grid">
        <article class="doing-card doing-wide tint-mint">
          <span class="doing-icon" aria-hidden="true">◈</span>
          <h3>Web development</h3>
          <p>From landing pages to ERP systems and full SaaS products. Scalable, secure, and built to grow with your business.</p>
        </article>
        <article class="doing-card tint-sky">
          <span class="doing-icon" aria-hidden="true">◎</span>
          <h3>Mobile apps</h3>
          <p>React Native, Expo or Flutter for one codebase — or fully native Android and iOS. From sketch to store.</p>
        </article>
        <article class="doing-card tint-peach">
          <span class="doing-icon" aria-hidden="true">✳</span>
          <h3>AI automation</h3>
          <p>Chatbots, lead flows and workflow automation that save your team hours every week.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="wrap">
    <div class="featured reveal">
      <h2 class="h2">Selected work</h2>
      <div class="featured-grid">
        <article class="feat-card feat-ink">
          <span class="feat-tag">Web and mobile</span>
          <h3>Apps your customers will actually enjoy</h3>
          <p>Modern web and mobile apps built around your business goal, not tech for its own sake.</p>
          <a href="/works">See my work →</a>
        </article>
        <article class="feat-card feat-paper">
          <span class="feat-tag">Automation</span>
          <h3>Let AI handle the boring parts</h3>
          <p>Follow-ups, data entry and reports, automated quietly in the background while you grow.</p>
          <a href="/contacts">Say hello →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- STACK -->
  <section class="wrap">
    <div class="stack reveal">
      <h2 class="h2">Tools I use</h2>
      <div class="stack-groups">
        <div class="stack-group tint-mint">
          <span class="group-label">Languages</span>
          <div class="pill-row">
            <span class="pill">TypeScript</span>
            <span class="pill">Python</span>
            <span class="pill">Dart</span>
            <span class="pill">Kotlin</span>
            <span class="pill">Swift</span>
          </div>
        </div>
        <div class="stack-group tint-sky">
          <span class="group-label">Frameworks</span>
          <div class="pill-row">
            <span class="pill">React</span>
            <span class="pill">Next.js</span>
            <span class="pill">Astro</span>
            <span class="pill">React Native</span>
            <span class="pill">Expo</span>
            <span class="pill">Flutter</span>
            <span class="pill">Tailwind CSS</span>
          </div>
        </div>
        <div class="stack-group tint-peach">
          <span class="group-label">Backend and AI</span>
          <div class="pill-row">
            <span class="pill">Node.js</span>
            <span class="pill">PostgreSQL</span>
            <span class="pill">OpenAI API</span>
            <span class="pill">Docker</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WRITING -->
  <section class="wrap">
    <div class="writing reveal">
      <div class="writing-head">
        <div>
          <span class="eyebrow">From the notebook</span>
          <h2 class="h2">Recent writing</h2>
        </div>
        <a href="/writing" class="btn-ghost btn-sm">All writing</a>
      </div>
      <div class="post-list">
        {recentPosts.map((post, i) => (
          <PostCard
            title={post.title}
            date={post.date}
            readTime={post.readTime}
            slug={post.slug}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="wrap">
    <div class="timeline reveal">
      <h2 class="h2">How we'll work together</h2>
      <ol class="timeline-list">
        <li><span class="t-year">01</span><span class="t-body"><strong>Tell me your goal</strong><em>A short call or a few messages. No jargon, no commitment.</em></span></li>
        <li><span class="t-year">02</span><span class="t-body"><strong>Lock your price</strong><em>The quote builder locks it instantly — big systems get a custom plan instead.</em></span></li>
        <li><span class="t-year">03</span><span class="t-body"><strong>Ship and improve</strong><em>Launch fast, then iterate based on real feedback.</em></span></li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="wrap">
    <div class="faq reveal">
      <h2 class="h2">Good questions</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary>Are you open for freelance projects?</summary>
          <p>Yes. I take on websites, mobile apps and automation projects. Write to me with your goal and timeline.</p>
        </details>
        <details class="faq-item">
          <summary>How much will it cost?</summary>
          <p>Starting prices are on the <a href="/pricing">pricing page</a> — and its quote builder locks your price on the spot, no discovery call needed. Only big custom systems like ERP are scoped individually.</p>
        </details>
        <details class="faq-item">
          <summary>How fast can we start?</summary>
          <p>Usually within one to two weeks. Small sites ship in days, apps in weeks.</p>
        </details>
        <details class="faq-item">
          <summary>Do you use AI in your work?</summary>
          <p>Daily. AI speeds up building, and powers features like chatbots and smart workflows inside your product.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CURRENTLY -->
  <section class="wrap">
    <div class="now-card reveal">
      <div>
        <h2 class="h2 h2-light">Have a project? Let's ship it.</h2>
        <p class="now-sub">Currently accepting new projects.</p>
      </div>
      <a href="/contacts" class="btn-lemon">Say hello</a>
    </div>
  </section>

</Layout>

<style>
  .wrap {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-3) 0;
  }

  .h2 {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: var(--text-3xl);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .h2-light { color: var(--color-paper); }

  .lede {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 56ch;
    margin-top: 12px;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    margin-bottom: var(--space-2);
  }

  /* Hero */
  .hero {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-3) 0;
    padding-top: var(--space-6);
    min-height: 0;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--space-4);
    align-items: center;
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: 28px;
    padding: var(--space-4);
    box-shadow: var(--shadow-card);
    animation: rise-in 600ms var(--ease) both;
  }

  .hero-title {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: var(--space-2);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 42ch;
    margin-bottom: var(--space-3);
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .btn-primary, .btn-ghost, .btn-lemon {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    border-radius: var(--radius-pill);
    padding: 13px 24px;
    border: 2px solid var(--color-ink);
    white-space: nowrap;
    transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
  }

  .btn-primary {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: 3px 3px 0 var(--color-accent);
  }

  .btn-primary:hover { transform: translate(-1px, -2px); box-shadow: 5px 5px 0 var(--color-accent); }
  .btn-primary:active { transform: translateY(1px) scale(0.98); box-shadow: 1px 1px 0 var(--color-accent); }

  .btn-ghost {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .btn-ghost:hover { background: var(--color-lemon); transform: translateY(-2px) rotate(-0.5deg); }
  .btn-ghost:active { transform: translateY(1px) scale(0.98); }

  .btn-sm { font-size: var(--text-sm); padding: 10px 18px; }

  .btn-lemon {
    background: var(--color-lemon);
    color: var(--color-ink);
  }

  .btn-lemon:hover { transform: translateY(-2px) rotate(1deg); }
  .btn-lemon:active { transform: translateY(1px) scale(0.98); }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 4px rgba(46, 125, 79, 0.18);
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .photo-arch {
    width: min(320px, 100%);
    aspect-ratio: 4 / 4.6;
    border-radius: 160px 160px 24px 24px;
    overflow: hidden;
    border: 2px solid var(--color-ink);
    background: var(--color-cream);
  }

  .photo-arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .sticker {
    position: absolute;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-ink);
    box-shadow: 2px 2px 0 var(--color-ink);
  }

  .sticker-a { top: 12%; left: 2%; background: var(--color-lemon); transform: rotate(-8deg); }
  .sticker-b { top: 44%; right: 0; background: var(--color-sky); transform: rotate(6deg); }
  .sticker-c { bottom: 10%; left: 8%; background: var(--color-paper-2); transform: rotate(-3deg); }

  /* Marquee */
  .marquee {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
  }

  .marquee-track span { padding: 12px 0; }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
  }

  .stat-card {
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: transform var(--duration) var(--ease);
  }

  .stat-card:hover { transform: translateY(-3px) rotate(-0.4deg); }

  .stat-hero { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .stat-hero .stat-label { color: var(--color-paper); opacity: 0.75; }

  .tint-mint { background: var(--color-mint); }
  .tint-sky { background: var(--color-sky); }
  .tint-peach { background: var(--color-peach); }

  .stat-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* Doing */
  .doing {
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: 28px;
    padding: var(--space-4);
    margin-top: var(--space-4);
    box-shadow: var(--shadow-card);
  }

  .doing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    margin-top: var(--space-3);
  }

  .doing-card {
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-2);
    transition: transform var(--duration) var(--ease);
  }

  .doing-card:hover { transform: translateY(-3px); }
  .doing-card h3 { font-family: var(--font-display); font-size: var(--text-xl); letter-spacing: -0.02em; margin: 10px 0 8px; }
  .doing-card p { color: var(--color-muted); font-size: var(--text-base); }

  .doing-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    font-weight: 700;
  }

  /* Featured */
  .featured { margin-top: var(--space-4); }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    margin-top: var(--space-2);
  }

  .feat-card {
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
  }

  .feat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-pop); }

  .feat-ink { background: var(--color-ink); color: var(--color-paper); }
  .feat-ink p { opacity: 0.75; }
  .feat-ink a { color: var(--color-lemon); font-weight: 700; }
  .feat-paper { background: var(--color-cream); }
  .feat-paper a { color: var(--color-accent); font-weight: 700; }

  .feat-tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    border: 2px solid currentColor;
    border-radius: var(--radius-pill);
    padding: 4px 12px;
  }

  .feat-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  /* Stack */
  .stack {
    margin-top: var(--space-4);
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-3);
  }

  .stack-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 12px;
    margin-top: calc(var(--space-2) + 14px);
  }

  .stack-group {
    position: relative;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-2) var(--space-2);
    transition: transform var(--duration) var(--ease);
  }

  .stack-group:hover { transform: translateY(-3px); }

  .group-label {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-2deg);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-lemon);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 4px 14px;
    box-shadow: 2px 2px 0 var(--color-ink);
  }

  .stack-group:nth-child(2) .group-label { transform: translate(-50%, -50%) rotate(1.5deg); }
  .stack-group:nth-child(3) .group-label { transform: translate(-50%, -50%) rotate(-1deg); }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .pill {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    transition: transform var(--duration) var(--ease);
  }

  .stack-group.tint-mint .pill { background: var(--color-mint-deep); }
  .stack-group.tint-sky .pill { background: var(--color-sky-deep); }
  .stack-group.tint-peach .pill { background: var(--color-peach-deep); }

  .pill:hover {
    transform: translateY(-2px);
  }

  /* Writing */
  .writing { margin-top: var(--space-4); }

  .writing-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Timeline */
  .timeline {
    margin-top: var(--space-4);
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-3);
  }

  .timeline-list {
    list-style: none;
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
  }

  .timeline-list li {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-top: 2px dashed var(--color-line);
  }

  .timeline-list li:first-child { border-top: none; }

  .t-year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .t-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .t-body strong { font-size: var(--text-base); }
  .t-body em { font-style: normal; color: var(--color-muted); font-size: var(--text-sm); }

  /* FAQ */
  .faq { margin-top: var(--space-4); }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: var(--space-2);
  }

  .faq-item {
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-2) var(--space-3);
  }

  .faq-item summary {
    font-family: var(--font-display);
