---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { posts } from '../data/posts';

const recentPosts = posts.slice(0, 3);
---

<Layout title="Jiilan Nashrulloh Tanjung">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jiilan Nashrulloh Tanjung",
    "alternateName": ["Jiilan", "JiilanTj", "Jiilan NT", "Jiilan Tanjung", "Jiilan Nashrulloh"],
    "url": "https://jiilan.me",
    "jobTitle": ["Software Engineer", "Physicist", "Researcher"],
    "knowsAbout": [
      "Computer Science",
      "Theoretical Physics",
      "Systems Engineering",
      "Distributed Systems",
      "Compiler Design",
      "Information Theory",
      "Quantum Computing"
    ],
    "sameAs": [
      "https://github.com/JiilanTj"
    ],
    "email": "jiilannashrulloh@gmail.com"
  })} />

  <!-- ═══ HERO: Photo + Identity ═══ -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text-col">
        <p class="hero-greeting">Jiilan Nashrulloh Tanjung</p>
        <h1 class="hero-headline">Software Engineer,<br />Physicist &amp; Researcher</h1>
        <p class="hero-bio">
          I operate at the boundary where theoretical physics meets systems engineering.
          Most of my work involves problems where the abstraction layers are leaking —
          where you need to understand both the mathematics and the metal to make progress.
        </p>
        <div class="hero-cta">
          <a href="/writing" class="cta-primary">Read my writing</a>
          <a href="/about" class="cta-secondary">More about me</a>
        </div>
      </div>

      <div class="hero-photo-col">
        <div class="photo-frame">
          <img src="/jiilan.png" alt="Jiilan Nashrulloh Tanjung" class="photo" width="400" height="400" />
          <div class="photo-glow"></div>
          <div class="photo-glow-top"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ NUMBERS / STATS ═══ -->
  <section class="stats">
    <div class="stats-inner">
      <div class="stat-item">
        <span class="stat-number">5+</span>
        <span class="stat-label">YEARS ENGINEERING</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number">3</span>
        <span class="stat-label">PUBLISHED PAPERS</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number">2</span>
        <span class="stat-label">RESEARCH DOMAINS</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number">10+</span>
        <span class="stat-label">OPEN SOURCE PROJECTS</span>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT I DO: Expertise Areas ═══ -->
  <section class="expertise">
    <div class="expertise-inner">
      <span class="section-label">WHAT I WORK ON</span>

      <div class="expertise-grid">
        <div class="expertise-card">
          <span class="expertise-number">01</span>
          <h3 class="expertise-title">Systems Engineering</h3>
          <p class="expertise-desc">
            Distributed systems, fault tolerance, and infrastructure
            where correctness is a hard constraint, not an aspiration.
          </p>
        </div>

        <div class="expertise-card">
          <span class="expertise-number">02</span>
          <h3 class="expertise-title">Computational Physics</h3>
          <p class="expertise-desc">
            Quantum error correction, simulation methods, and the computational
            complexity of physical systems.
          </p>
        </div>

        <div class="expertise-card">
          <span class="expertise-number">03</span>
          <h3 class="expertise-title">Research &amp; Theory</h3>
          <p class="expertise-desc">
            Information theory, compiler correctness, and mathematical
            foundations of machine learning.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PHILOSOPHY: How I Think ═══ -->
  <section class="philosophy">
    <div class="philosophy-inner">
      <span class="section-label">HOW I THINK</span>
      <blockquote class="philosophy-quote">
        "I think about invariants before implementations and entropy before optimization.
        I write software the way I write proofs: with the failure modes stated up front."
      </blockquote>
    </div>
  </section>

  <!-- ═══ TECH STACK ═══ -->
  <section class="stack">
    <div class="stack-inner">
      <span class="section-label">TECH STACK &amp; TOOLS</span>
      <div class="stack-grid">
        <div class="stack-group">
          <h4 class="stack-group-title">Languages</h4>
          <div class="stack-tags">
            <span class="stack-tag">Python</span>
            <span class="stack-tag">TypeScript</span>
            <span class="stack-tag">Rust</span>
            <span class="stack-tag">C++</span>
            <span class="stack-tag">Go</span>
            <span class="stack-tag">Julia</span>
          </div>
        </div>
        <div class="stack-group">
          <h4 class="stack-group-title">Frameworks &amp; Runtime</h4>
          <div class="stack-tags">
            <span class="stack-tag">Node.js</span>
            <span class="stack-tag">Astro</span>
            <span class="stack-tag">React</span>
            <span class="stack-tag">Next.js</span>
            <span class="stack-tag">FastAPI</span>
          </div>
        </div>
        <div class="stack-group">
          <h4 class="stack-group-title">Infrastructure</h4>
          <div class="stack-tags">
            <span class="stack-tag">Docker</span>
            <span class="stack-tag">Kubernetes</span>
            <span class="stack-tag">PostgreSQL</span>
            <span class="stack-tag">Redis</span>
            <span class="stack-tag">gRPC</span>
          </div>
        </div>
        <div class="stack-group">
          <h4 class="stack-group-title">Research &amp; Scientific</h4>
          <div class="stack-tags">
            <span class="stack-tag">NumPy</span>
            <span class="stack-tag">JAX</span>
            <span class="stack-tag">Qiskit</span>
            <span class="stack-tag">LaTeX</span>
            <span class="stack-tag">MATLAB</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FEATURED WORK ═══ -->
  <section class="featured">
    <div class="featured-inner">
      <span class="section-label">FEATURED</span>
      <div class="featured-grid">
        <div class="featured-card">
          <span class="featured-type">PAPER</span>
          <h3 class="featured-title">On the Computational Complexity of Real-Time Quantum Error Decoding</h3>
          <p class="featured-desc">
            Establishing a lower bound on decoder latency for fault-tolerant quantum computation.
            Published in arXiv, 2025.
          </p>
          <a href="/research" class="featured-link">Read paper →</a>
        </div>
        <div class="featured-card">
          <span class="featured-type">PROJECT</span>
          <h3 class="featured-title">Fault-Tolerant Distributed Compute Engine</h3>
          <p class="featured-desc">
            A distributed compute framework designed around formal correctness guarantees.
            Handles Byzantine failures without sacrificing throughput.
          </p>
          <a href="/works" class="featured-link">View project →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TIMELINE / MILESTONES ═══ -->
  <section class="timeline">
    <div class="timeline-inner">
      <span class="section-label">MILESTONES</span>
      <div class="timeline-list">
        <div class="timeline-item">
          <span class="timeline-year">2025</span>
          <div class="timeline-content">
            <h4 class="timeline-title">Published first paper on quantum error correction complexity</h4>
            <p class="timeline-desc">arXiv preprint — Quantum Computing</p>
          </div>
        </div>
        <div class="timeline-item">
          <span class="timeline-year">2024</span>
          <div class="timeline-content">
            <h4 class="timeline-title">Built fault-tolerant distributed compute engine</h4>
            <p class="timeline-desc">Open-sourced on GitHub — formal correctness guarantees at scale</p>
          </div>
        </div>
        <div class="timeline-item">
          <span class="timeline-year">2024</span>
          <div class="timeline-content">
            <h4 class="timeline-title">Presented at Workshop on Principles of Distributed Systems</h4>
            <p class="timeline-desc">Consistency Envelopes — a framework for honest distributed guarantees</p>
          </div>
        </div>
        <div class="timeline-item">
          <span class="timeline-year">2023</span>
          <div class="timeline-content">
            <h4 class="timeline-title">Started quantum computing research program</h4>
            <p class="timeline-desc">Transitioned from pure systems engineering to computational physics</p>
          </div>
        </div>
        <div class="timeline-item">
          <span class="timeline-year">2020</span>
          <div class="timeline-content">
            <h4 class="timeline-title">First production distributed system shipped</h4>
            <p class="timeline-desc">Infrastructure serving millions of requests with formal correctness properties</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ RECENT WRITING ═══ -->
  <section class="recent">
    <div class="recent-inner">
      <div class="recent-header">
        <span class="section-label">RECENT WRITING</span>
        <a href="/writing" class="all-writing-link">All writing →</a>
      </div>

      <div class="post-list">
        {recentPosts.map((post, i) => (
          <PostCard
            title={post.title}
            date={post.date}
            readTime={post.readTime}
            slug={post.slug}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="faq">
    <div class="faq-inner">
      <span class="section-label">FREQUENTLY ASKED</span>

      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">Are you available for freelance or consulting work?</summary>
          <p class="faq-answer">
            It depends on the project. I take on select consulting engagements
            in distributed systems, computational physics, and research-heavy engineering.
            Reach out via email and describe what you're working on.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">What's your background — physics or engineering?</summary>
          <p class="faq-answer">
            Both. I was trained in physics and drawn to engineering. The combination
            means I think about invariants before implementations. I approach software
            problems with a physicist's rigor and an engineer's pragmatism.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Do you collaborate on research?</summary>
          <p class="faq-answer">
            Yes — particularly in quantum error correction, distributed systems theory,
            and the computational foundations of machine learning. If you're working on
            something in these areas, I'd like to hear about it.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">What tools and languages do you prefer?</summary>
          <p class="faq-answer">
            Depends on the problem. Python and Julia for research and prototyping.
            Rust and Go for systems work. TypeScript for web tooling.
            I don't have loyalty to tools — I have loyalty to correctness.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Can I use your writing or cite your work?</summary>
          <p class="faq-answer">
            Published papers follow standard academic citation norms. Blog posts and
            technical writing on this site can be referenced with attribution.
            If in doubt, send me a message.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- ═══ CURRENTLY ═══ -->
  <section class="currently">
    <div class="currently-inner">
      <span class="section-label">CURRENTLY</span>
      <p class="currently-text">
        Investigating fault-tolerant quantum computing architectures.
        Building infrastructure that treats correctness as a non-negotiable constraint.
      </p>
      <div class="currently-links">
        <a href="mailto:jiilannashrulloh@gmail.com" class="contact-link">jiilannashrulloh@gmail.com</a>
        <span class="link-sep">·</span>
        <a href="https://github.com/JiilanTj" class="contact-link" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ── */
  .hero {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) 0;
    padding-top: calc(var(--space-12) + 64px);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-8);
    align-items: center;
  }

  .hero-photo-col {
    position: relative;
  }

  .photo-frame {
    position: relative;
    width: 100%;
    max-width: 280px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: contrast(1.05) brightness(0.85) saturate(0.7);
  }

  .photo-glow {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(to top, var(--color-bg) 0%, transparent 100%);
    pointer-events: none;
    animation: glow-breathe 6s var(--ease-melancholy) infinite;
  }

  .photo-glow-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 25%;
    background: linear-gradient(to bottom, var(--color-bg) 0%, transparent 100%);
    pointer-events: none;
  }

  @keyframes glow-breathe {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  .hero-text-col {
    max-width: 600px;
  }

  .hero-greeting {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-accent);
    opacity: 0.85;
    letter-spacing: 0.12em;
    margin-bottom: 20px;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 30px;
  }

  .hero-bio {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 520px;
    margin-bottom: var(--space-4);
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .cta-primary {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-accent);
    background: rgba(122, 143, 173, 0.15);
    border: 1px solid var(--color-accent);
    padding: 12px 28px;
    border-radius: 4px;
    letter-spacing: 0.04em;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .cta-primary:hover {
    background: rgba(122, 143, 173, 0.08);
    border-color: #8da0be;
  }

  .cta-secondary {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-text-ghost);
    letter-spacing: 0.02em;
    padding: 12px 28px;
    border: 1px solid #1c2030;
    border-radius: 4px;
    background: transparent;
    transition: color 180ms ease, border-color 180ms ease;
  }

  .cta-secondary:hover {
    color: var(--color-text-muted);
    border-color: #2d3348;
  }

  /* ── Section Label ── */
  .section-label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--color-text-ghost);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: var(--space-4);
  }

  /* ── Stats ── */
  .stats {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .stats-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-accent);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    color: var(--color-text-ghost);
    letter-spacing: 0.1em;
    text-align: center;
  }

  .stat-divider {
    width: 1px;
    height: 24px;
    background: var(--color-border);
    align-self: center;
  }

  /* ── Expertise ── */
  .expertise {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }

  .expertise-inner {
    max-width: var(--page-width);
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .expertise-card {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color var(--duration-md) var(--ease);
  }

  .expertise-card:hover {
    border-color: var(--color-accent);
  }

  .expertise-number {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .expertise-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-1);
  }

  .expertise-desc {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* ── Philosophy ── */
  .philosophy {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
  }

  .philosophy-inner {
    max-width: var(--content-width);
  }

  .philosophy-quote {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text);
    line-height: 1.5;
    letter-spacing: -0.01em;
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-3);
    font-style: italic;
  }

  /* ── Tech Stack ── */
  .stack {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .stack-inner {
    max-width: var(--page-width);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .stack-group-title {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .stack-tag {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    transition: border-color var(--duration) var(--ease), color var(--duration) var(--ease);
  }

  .stack-tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ── Featured ── */
  .featured {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .featured-inner {
    max-width: var(--page-width);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .featured-card {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color var(--duration-md) var(--ease);
  }

  .featured-card:hover {
    border-color: var(--color-accent);
  }

  .featured-type {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: var(--space-1);
  }

  .featured-desc {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-2);
  }

  .featured-link {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-accent);
    letter-spacing: 0.02em;
    transition: opacity var(--duration) var(--ease);
  }

  .featured-link:hover {
    opacity: 0.8;
  }

  /* ── Timeline ── */
  .timeline {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .timeline-inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-2);
    position: relative;
  }

  .timeline-item:last-child {
    border-bottom: none;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: 66px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border-2);
  }

  .timeline-item:last-child::before {
    display: none;
  }

  .timeline-year {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--color-text-ghost);
    letter-spacing: 0.06em;
    padding-top: 2px;
  }

  .timeline-content {
    padding-left: var(--space-2);
  }

  .timeline-title {
