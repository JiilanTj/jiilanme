---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../data/posts';

interface YearGroup {
  year: string;
  posts: typeof posts;
}

const grouped = posts.reduce<YearGroup[]>((acc, post) => {
  const year = new Date(post.date).getFullYear().toString();
  const existing = acc.find((g) => g.year === year);
  if (existing) {
    existing.posts.push(post);
  } else {
    acc.push({ year, posts: [post] });
  }
  return acc;
}, []);
---

<Layout title="Writing — Jiilan Nashrulloh Tanjung">
  <section class="writing-page">
    <header class="page-header">
      <h1 class="page-title">Writing</h1>
      <p class="page-subtitle">Technical notes, research observations, and opinions written carefully.</p>
      <hr class="page-rule" />
    </header>

    <div class="year-groups">
      {grouped.map((group, gi) => (
        <div class="year-group">
          <div class="year-rail">
            <span class="year-label">{group.year}</span>
          </div>
          <div class="year-posts">
            {group.posts.map((post, i) => (
              <PostCard
                title={post.title}
                date={post.date}
                readTime={post.readTime}
                slug={post.slug}
                index={gi * 5 + i}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .writing-page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
    padding-top: calc(var(--space-12) + 64px);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .page-subtitle {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    margin-top: var(--space-1);
    line-height: 1.5;
  }

  .page-rule {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin-top: var(--space-4);
  }

  .year-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .year-group {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .year-rail {
    position: sticky;
    top: calc(64px + var(--space-3));
  }

  .year-label {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    color: #1f1f1f;
    line-height: 1;
    letter-spacing: -0.02em;
    user-select: none;
  }

  .year-posts {
    max-width: var(--content-width);
  }

  @media (max-width: 768px) {
    .writing-page {
      padding: var(--space-8) var(--space-3);
      padding-top: calc(var(--space-8) + 64px);
    }

    .year-group {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .year-rail {
      position: static;
    }

    .year-label {
      font-size: var(--text-2xl);
      color: var(--color-text-ghost);
    }
  }
</style>
