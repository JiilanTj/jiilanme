---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../data/posts';

const recentPosts = posts.slice(0, 3);
---

<Layout
  lang="id"
  alternate="/"
  title="Jiilan Nashrulloh Tanjung — Jasa Web, Aplikasi & Otomasi AI"
  description="Jasa pembuatan website, aplikasi mobile & otomasi AI. Kamu bawa tujuan, saya yang eksekusi."
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jiilan Nashrulloh Tanjung",
    "alternateName": ["Jiilan", "JiilanTj", "Jiilan NT", "Jiilan Tanjung", "Jiilan Nashrulloh"],
    "url": "https://jiilan.me",
    "jobTitle": ["Full-Stack Developer"],
    "knowsAbout": [
      "Web Development",
      "Mobile App Development",
      "Business Automation",
      "AI Integration",
      "React",
      "React Native"
    ],
    "sameAs": [
      "https://github.com/JiilanTj"
    ],
    "email": "jiilannashrulloh@gmail.com"
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Apakah terima proyek freelance?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ya. Saya ngerjain website, aplikasi mobile dan proyek otomasi. Tulis tujuan dan timeline-mu." }
      },
      {
        "@type": "Question",
        "name": "Berapa biayanya?",
        "acceptedAnswer": { "@type": "Answer", "text": "Harga awal ada di halaman pricing, dan quote builder-nya ngunci hargamu langsung tanpa discovery call. Cuma sistem custom gede kayak ERP yang di-scope individual." }
      },
      {
        "@type": "Question",
        "name": "Seberapa cepat bisa mulai?",
        "acceptedAnswer": { "@type": "Answer", "text": "Biasanya dalam satu sampai dua minggu. Site kecil launch dalam hitungan hari, aplikasi dalam hitungan minggu." }
      },
      {
        "@type": "Question",
        "name": "Pakai AI dalam kerjaan?",
        "acceptedAnswer": { "@type": "Answer", "text": "Tiap hari. AI ngebutin build, dan jadi fitur kayak chatbot dan smart workflow di dalam produkmu." }
      }
    ]
  })} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Halo, saya Jiilan, full-stack developer</span>
        <h1 class="hero-title">Saya bikin aplikasi<br />dan otomasi yang ngembangin bisnismu.</h1>
        <p class="hero-sub">Jasa web development, aplikasi mobile & otomasi AI. Kamu bawa tujuan, saya yang eksekusi.</p>
        <div class="hero-ctas">
          <a href="/id/works" class="btn-primary">Lihat karya</a>
          <a href="/id/contacts" class="btn-ghost">Hubungi saya</a>
        </div>
        <div class="hero-meta">
          <span class="pulse" aria-hidden="true"></span>
          <span>Siap untuk proyek baru</span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="photo-arch">
          <img src="/jiilan.webp" alt="Foto Jiilan Nashrulloh Tanjung" width="400" height="400" loading="eager" decoding="async" fetchpriority="high" />
        </div>
        <span class="sticker sticker-a">web</span>
        <span class="sticker sticker-b">mobile</span>
        <span class="sticker sticker-c">otomasi AI</span>
      </div>
    </div>
  </section>

  <!-- MARQUEE (one per page). Even halves = seamless −50% loop. -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {Array.from({ length: 8 }).map(() => (
        <span>aplikasi web · aplikasi mobile · otomasi AI · landing page · dashboard · chatbot · sistem ERP · produk SaaS · API · integrasi ·&nbsp;</span>
      ))}
    </div>
  </div>

  <!-- STATS BENTO -->
  <section class="wrap">
    <div class="stats-grid reveal">
      <div class="stat-card stat-hero">
        <span class="stat-num">5+</span>
        <span class="stat-label">tahun bikin software</span>
      </div>
      <div class="stat-card tint-mint">
        <span class="stat-num">10+</span>
        <span class="stat-label">proyek dan open source</span>
      </div>
      <div class="stat-card tint-sky">
        <span class="stat-num">3</span>
        <span class="stat-label">fokus: web, mobile, AI</span>
      </div>
      <div class="stat-card tint-peach">
        <span class="stat-num">→</span>
        <span class="stat-label">proyekmu berikutnya</span>
      </div>
    </div>
  </section>

  <!-- WHAT I DO -->
  <section class="wrap">
    <div class="doing reveal">
      <div class="doing-head">
        <h2 class="h2">Semua yang kamu butuhkan untuk launch.</h2>
        <p class="lede">Satu developer untuk websitemu, aplikasimu dan otomasi di antaranya. Tanpa handoff, tanpa overhead agensi.</p>
      </div>
      <div class="doing-grid">
        <article class="doing-card doing-wide tint-mint">
          <span class="doing-icon" aria-hidden="true">◈</span>
          <h3>Web development</h3>
          <p>Dari landing page sampai sistem ERP dan produk SaaS. Scalable, aman, dan tumbuh bareng bisnismu.</p>
        </article>
        <article class="doing-card tint-sky">
          <span class="doing-icon" aria-hidden="true">◎</span>
          <h3>Aplikasi mobile</h3>
          <p>React Native, Expo atau Flutter untuk satu codebase, atau native Android dan iOS. Dari sketsa sampai store.</p>
        </article>
        <article class="doing-card tint-peach">
          <span class="doing-icon" aria-hidden="true">✳</span>
          <h3>Otomasi AI</h3>
          <p>Chatbot, lead flow dan otomasi workflow yang hematin jam kerja tim tiap minggu.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="wrap">
    <div class="featured reveal">
      <h2 class="h2">Karya pilihan</h2>
      <div class="featured-grid">
        <article class="feat-card feat-ink">
          <span class="feat-tag">Web dan Mobile</span>
          <h3>Aplikasi yang disukai customermu</h3>
          <p>Aplikasi web dan mobile modern yang dibangun dari tujuan bisnismu. Bukan teknologi demi teknologi.</p>
          <a href="/id/works">Lihat karya saya →</a>
        </article>
        <article class="feat-card feat-paper">
          <span class="feat-tag">Otomasi</span>
          <h3>Biar AI yang kerjain yang membosankan</h3>
          <p>Follow-up, input data dan laporan, terotomasi diam-diam di background selagi kamu grow.</p>
          <a href="/id/contacts">Hubungi saya →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- STACK -->
  <section class="wrap">
    <div class="stack reveal">
      <h2 class="h2">Tools yang saya pakai</h2>
      <div class="stack-groups">
        <div class="stack-group tint-mint">
          <span class="group-label">Bahasa</span>
          <div class="pill-row">
            <span class="pill">TypeScript</span>
            <span class="pill">Python</span>
            <span class="pill">Dart</span>
            <span class="pill">Kotlin</span>
            <span class="pill">Swift</span>
          </div>
        </div>
        <div class="stack-group tint-sky">
          <span class="group-label">Framework</span>
          <div class="pill-row">
            <span class="pill">React</span>
            <span class="pill">Next.js</span>
            <span class="pill">Astro</span>
            <span class="pill">React Native</span>
            <span class="pill">Expo</span>
            <span class="pill">Flutter</span>
            <span class="pill">Tailwind CSS</span>
          </div>
        </div>
        <div class="stack-group tint-peach">
          <span class="group-label">Backend dan AI</span>
          <div class="pill-row">
            <span class="pill">Node.js</span>
            <span class="pill">PostgreSQL</span>
            <span class="pill">OpenAI API</span>
            <span class="pill">Docker</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WRITING -->
  <section class="wrap">
    <div class="writing reveal">
      <div class="writing-head">
        <div>
          <span class="eyebrow">Dari catatan</span>
          <h2 class="h2">Tulisan terbaru</h2>
        </div>
        <a href="/id/writing" class="btn-ghost btn-sm">Semua tulisan</a>
      </div>
      <div class="post-list">
        {recentPosts.map((post, i) => (
          <PostCard
            title={post.title}
            date={post.date}
            readTime={post.readTime}
            slug={post.slug}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="wrap">
    <div class="timeline reveal">
      <h2 class="h2">Cara kerja bareng</h2>
      <ol class="timeline-list">
        <li><span class="t-year">01</span><span class="t-body"><strong>Ceritain tujuanmu</strong><em>Call singkat atau beberapa pesan. Tanpa jargon, tanpa komitmen.</em></span></li>
        <li><span class="t-year">02</span><span class="t-body"><strong>Kunci hargamu</strong><em>Quote builder ngunci langsung. Sistem gede dapet custom plan.</em></span></li>
        <li><span class="t-year">03</span><span class="t-body"><strong>Launch dan improve</strong><em>Launch cepat, lalu iterasi dari feedback beneran.</em></span></li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="wrap">
    <div class="faq reveal">
      <h2 class="h2">Pertanyaan bagus</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary>Apakah terima proyek freelance?</summary>
          <p>Ya. Saya ngerjain website, aplikasi mobile dan proyek otomasi. Tulis tujuan dan timeline-mu.</p>
        </details>
        <details class="faq-item">
          <summary>Berapa biayanya?</summary>
          <p>Harga awal ada di <a href="/id/pricing">halaman pricing</a>. Quote builder-nya ngunci hargamu langsung, tanpa discovery call. Cuma sistem custom gede kayak ERP yang di-scope individual.</p>
        </details>
        <details class="faq-item">
          <summary>Seberapa cepat bisa mulai?</summary>
          <p>Biasanya dalam satu sampai dua minggu. Site kecil launch dalam hitungan hari, aplikasi dalam hitungan minggu.</p>
        </details>
        <details class="faq-item">
          <summary>Pakai AI dalam kerjaan?</summary>
          <p>Tiap hari. AI ngebutin build, dan jadi fitur kayak chatbot dan smart workflow di dalam produkmu.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CURRENTLY -->
  <section class="wrap">
    <div class="now-card reveal">
      <div>
        <h2 class="h2 h2-light">Punya proyek? Mari wujudkan.</h2>
        <p class="now-sub">Lagi terima proyek baru.</p>
      </div>
      <a href="/id/contacts" class="btn-lemon">Hubungi saya</a>
    </div>
  </section>

</Layout>

<style>
  .wrap {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-3) 0;
  }

  .h2 {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: var(--text-3xl);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .h2-light { color: var(--color-paper); }

  .lede {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 56ch;
    margin-top: 12px;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    margin-bottom: var(--space-2);
  }

  /* Hero */
  .hero {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-3) 0;
    padding-top: var(--space-6);
    min-height: 0;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--space-4);
    align-items: center;
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: 28px;
    padding: var(--space-4);
    box-shadow: var(--shadow-card);
    animation: rise-in 600ms var(--ease) both;
  }

  .hero-title {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: var(--space-2);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 42ch;
    margin-bottom: var(--space-3);
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .btn-primary, .btn-ghost, .btn-lemon {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    border-radius: var(--radius-pill);
    padding: 13px 24px;
    border: 2px solid var(--color-ink);
    white-space: nowrap;
    transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
  }

  .btn-primary {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: 3px 3px 0 var(--color-accent);
  }

  .btn-primary:hover { transform: translate(-1px, -2px); box-shadow: 5px 5px 0 var(--color-accent); }
  .btn-primary:active { transform: translateY(1px) scale(0.98); box-shadow: 1px 1px 0 var(--color-accent); }

  .btn-ghost {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .btn-ghost:hover { background: var(--color-lemon); transform: translateY(-2px) rotate(-0.5deg); }
  .btn-ghost:active { transform: translateY(1px) scale(0.98); }

  .btn-sm { font-size: var(--text-sm); padding: 10px 18px; }

  .btn-lemon {
    background: var(--color-lemon);
    color: var(--color-ink);
  }

  .btn-lemon:hover { transform: translateY(-2px) rotate(1deg); }
  .btn-lemon:active { transform: translateY(1px) scale(0.98); }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 4px rgba(46, 125, 79, 0.18);
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .photo-arch {
    width: min(320px, 100%);
    aspect-ratio: 4 / 4.6;
    border-radius: 160px 160px 24px 24px;
    overflow: hidden;
    border: 2px solid var(--color-ink);
    background: var(--color-cream);
  }

  .photo-arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .sticker {
    position: absolute;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-ink);
    box-shadow: 2px 2px 0 var(--color-ink);
  }

  .sticker-a { top: 12%; left: 2%; background: var(--color-lemon); transform: rotate(-8deg); }
  .sticker-b { top: 44%; right: 0; background: var(--color-sky); transform: rotate(6deg); }
  .sticker-c { bottom: 10%; left: 8%; background: var(--color-paper-2); transform: rotate(-3deg); }

  /* Marquee */
  .marquee {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
  }

  .marquee-track span { padding: 12px 0; }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
  }

  .stat-card {
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: transform var(--duration) var(--ease);
  }

  .stat-card:hover { transform: translateY(-3px) rotate(-0.4deg); }

  .stat-hero { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .stat-hero .stat-label { color: var(--color-paper); opacity: 0.75; }

  .tint-mint { background: var(--color-mint); }
  .tint-sky { background: var(--color-sky); }
  .tint-peach { background: var(--color-peach); }

  .stat-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* Doing */
  .doing {
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: 28px;
    padding: var(--space-4);
    margin-top: var(--space-4);
    box-shadow: var(--shadow-card);
  }

  .doing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    margin-top: var(--space-3);
  }

  .doing-card {
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-2);
    transition: transform var(--duration) var(--ease);
  }

  .doing-card:hover { transform: translateY(-3px); }
  .doing-card h3 { font-family: var(--font-display); font-size: var(--text-xl); letter-spacing: -0.02em; margin: 10px 0 8px; }
  .doing-card p { color: var(--color-muted); font-size: var(--text-base); }

  .doing-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    font-weight: 700;
  }

  /* Featured */
  .featured { margin-top: var(--space-4); }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    margin-top: var(--space-2);
  }

  .feat-card {
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
  }

  .feat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-pop); }

  .feat-ink { background: var(--color-ink); color: var(--color-paper); }
  .feat-ink p { opacity: 0.75; }
  .feat-ink a { color: var(--color-lemon); font-weight: 700; }
  .feat-paper { background: var(--color-cream); }
  .feat-paper a { color: var(--color-accent); font-weight: 700; }

  .feat-tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    border: 2px solid currentColor;
    border-radius: var(--radius-pill);
    padding: 4px 12px;
  }

  .feat-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  /* Stack */
  .stack {
    margin-top: var(--space-4);
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-3);
  }

  .stack-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 12px;
    margin-top: calc(var(--space-2) + 14px);
  }

  .stack-group {
    position: relative;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-2) var(--space-2);
    transition: transform var(--duration) var(--ease);
  }

  .stack-group:hover { transform: translateY(-3px); }

  .group-label {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-2deg);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-lemon);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 4px 14px;
    box-shadow: 2px 2px 0 var(--color-ink);
  }

  .stack-group:nth-child(2) .group-label { transform: translate(-50%, -50%) rotate(1.5deg); }
  .stack-group:nth-child(3) .group-label { transform: translate(-50%, -50%) rotate(-1deg); }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .pill {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    transition: transform var(--duration) var(--ease);
  }

  .stack-group.tint-mint .pill { background: var(--color-mint-deep); }
  .stack-group.tint-sky .pill { background: var(--color-sky-deep); }
