---
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import { posts } from '../../../data/posts';

interface YearGroup {
  year: string;
  posts: typeof posts;
}

const grouped = posts.reduce<YearGroup[]>((acc, post) => {
  const year = new Date(post.date).getFullYear().toString();
  const existing = acc.find((g) => g.year === year);
  if (existing) {
    existing.posts.push(post);
  } else {
    acc.push({ year, posts: [post] });
  }
  return acc;
}, []);
---

<Layout lang="id" alternate="/writing" title="Tulisan — Jiilan Nashrulloh Tanjung" description="Catatan, esai dan hal yang dipelajari sambil membangun.">
  <section class="page">
    <header class="head reveal">
      <h1 class="title">Tulisan</h1>
      <p class="sub">Catatan, esai dan hal yang saya pelajari sambil membangun.</p>
    </header>

    <div class="groups">
      {grouped.map((group) => (
        <section class="year-block reveal">
          <div class="year-head">
            <h2 class="year">{group.year}</h2>
            <span class="year-count">{group.posts.length} esai</span>
          </div>
          <div class="posts">
            {group.posts.map((post, i) => (
              <PostCard
                title={post.title}
                date={post.date}
                readTime={post.readTime}
                slug={post.slug}
                index={i}
                locale="id-ID"
                base="/id/writing"
              />
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page { max-width: var(--page-width); margin: 0 auto; padding: var(--space-4) var(--space-3) var(--space-8); }
  .title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-4xl); letter-spacing: -0.03em; line-height: 1.05; }
  .sub { color: var(--color-muted); font-size: var(--text-lg); margin-top: 10px; }
  .groups { display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-3); }
  .year-head {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: var(--space-2);
  }
  .year {
    font-family: var(--font-display); font-weight: 700;
    font-size: var(--text-2xl); letter-spacing: -0.02em; line-height: 1;
  }
  .year-count {
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    color: var(--color-ink); background: var(--color-lemon);
    border: 2px solid var(--color-ink); border-radius: var(--radius-pill);
    padding: 4px 12px;
  }
  .posts { display: flex; flex-direction: column; gap: 12px; }
  @media (max-width: 768px) {
    .page { padding: var(--space-3) var(--space-2) var(--space-6); }
    .title { font-size: var(--text-3xl); }
    .year { font-size: var(--text-xl); }
  }
</style>
