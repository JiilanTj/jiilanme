---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="id" alternate="/pricing" title="Harga — Jiilan Nashrulloh Tanjung" description="Harga awal untuk website, aplikasi mobile dan otomasi AI. Quote pasti, tanpa hourly billing.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Jiilan Nashrulloh Tanjung — Full-Stack Development",
    "url": "https://jiilan.me/id/pricing",
    "priceRange": "Rp2,5jt+",
    "areaServed": "Indonesia",
    "makesOffer": [
      { "@type": "Offer", "name": "Landing page", "price": "2500000", "priceCurrency": "IDR" },
      { "@type": "Offer", "name": "Company site", "price": "8000000", "priceCurrency": "IDR" },
      { "@type": "Offer", "name": "Mobile app", "price": "25000000", "priceCurrency": "IDR" },
      { "@type": "Offer", "name": "AI automation", "price": "4000000", "priceCurrency": "IDR" }
    ]
  })} />
  <section class="page">
    <header class="page-head reveal">
      <span class="kicker">Harga</span>
      <h1 class="page-title">Harga jujur, quote terkunci.</h1>
      <p class="page-sub">Harga awal di bawah. Atau rakit quotemu sendiri di bawah buat harga yang terkunci begitu kamu kirim.</p>
    </header>

    <div class="grid">
      <article class="card tint-lemon reveal">
        <span class="tag">Landing page</span>
        <p class="starts">Mulai dari</p>
        <p class="price">Rp 2,5 jt</p>
        <p class="typical">Umumnya: Rp 2,5–6 jt</p>
        <ul>
          <li>Desain custom, tanpa template</li>
          <li>Copy polish dan SEO dasar</li>
          <li>Integrasi WhatsApp dan kontak</li>
          <li>Launch dalam hitungan hari</li>
        </ul>
        <a href="#estimator" class="card-cta">Rakit quotemu →</a>
      </article>

      <article class="card tint-mint reveal">
        <span class="tag">Company site</span>
        <p class="starts">Mulai dari</p>
        <p class="price">Rp 8 jt</p>
        <p class="typical">Umumnya: Rp 8–20 jt</p>
        <ul>
          <li>Semua yang ada di Landing page</li>
          <li>Edit konten sendiri pakai CMS</li>
          <li>Dashboard buat leads dan konten</li>
          <li>Analytics disiapin sekalian</li>
        </ul>
        <a href="#estimator" class="card-cta">Rakit quotemu →</a>
      </article>

      <article class="card tint-sky reveal">
        <span class="tag">Aplikasi mobile</span>
        <p class="starts">Mulai dari</p>
        <p class="price">Rp 25 jt</p>
        <p class="typical">Umumnya: Rp 25–60 jt</p>
        <ul>
          <li>iOS dan Android, satu codebase</li>
          <li>Rilis ke dua store diurusin</li>
          <li>Backend dan dashboard admin</li>
          <li>Bug fix gratis sebulan pertama</li>
        </ul>
        <a href="#estimator" class="card-cta">Rakit quotemu →</a>
      </article>

      <article class="card tint-peach reveal">
        <span class="tag">Otomasi AI</span>
        <p class="starts">Mulai dari</p>
        <p class="price">Rp 4 jt</p>
        <p class="typical">Umumnya: Rp 4–15 jt</p>
        <ul>
          <li>AI chatbot buat website atau chat</li>
          <li>Leads kesimpen ke tools-mu</li>
          <li>Satu workflow inti, end to end</li>
          <li>Dokumentasi dan handover call</li>
        </ul>
        <a href="#estimator" class="card-cta">Rakit quotemu →</a>
      </article>
    </div>

    <div class="estimator reveal" id="estimator">
      <span class="tag">Estimasi custom</span>
      <h2>Rakit quotemu sendiri.</h2>
      <p class="est-sub">Pilih tipe, tambah fitur, pilih kecepatan. Harga update live.</p>

      <div class="est-block">
        <p class="est-label">Tipe proyek: gabung biar dapet diskon bundle</p>
        <div class="opt-row">
          <label class="opt"><input type="checkbox" name="ptype" value="2500000" /><span>Landing page <em>Rp2,5jt+</em></span></label>
          <label class="opt"><input type="checkbox" name="ptype" value="8000000" checked /><span>Company site <em>Rp8jt+</em></span></label>
          <label class="opt"><input type="checkbox" name="ptype" value="25000000" /><span>Aplikasi mobile <em>Rp25jt+</em></span></label>
          <label class="opt"><input type="checkbox" name="ptype" value="4000000" /><span>Otomasi <em>Rp4jt+</em></span></label>
          <label class="opt"><input type="checkbox" name="ptype" value="50000000" /><span>ERP / SaaS <em>Rp50jt+</em></span></label>
        </div>
      </div>

      <div class="est-block">
        <p class="est-label">Fitur inti</p>
        <div class="opt-row">
          <label class="opt"><input type="checkbox" name="feat" value="5000000" /><span>Admin dashboard <em>+Rp5jt</em></span></label>
          <label class="opt"><input type="checkbox" name="feat" value="4000000" /><span>Akun dan auth <em>+Rp4jt</em></span></label>
          <label class="opt"><input type="checkbox" name="feat" value="6000000" /><span>Payment <em>+Rp6jt</em></span></label>
          <label class="opt"><input type="checkbox" name="feat" value="6500000" /><span>AI chatbot <em>+Rp6,5jt</em></span></label>
          <label class="opt"><input type="checkbox" name="feat" value="2500000" /><span>Multibahasa <em>+Rp2,5jt</em></span></label>
          <label class="opt"><input type="checkbox" name="feat" value="0" /><span>CMS <b class="free">Gratis</b></span></label>
          <label class="opt"><input type="checkbox" name="feat" value="0" /><span>SEO dasar <b class="free">Gratis</b></span></label>
          <label class="opt"><input type="checkbox" name="feat" value="0" /><span>Setup analytics <b class="free">Gratis</b></span></label>
          <label class="opt"><input type="checkbox" name="feat" value="0" /><span>Setup SSL dan hosting <b class="free">Gratis</b></span></label>
          <label class="opt"><input type="checkbox" name="feat" value="0" /><span>Handover call <b class="free">Gratis</b></span></label>
        </div>
      </div>

      <div class="est-block">
        <p class="est-label">Revisi</p>
        <div class="opt-row">
          <label class="opt"><input type="radio" name="rev" value="2" checked /><span>2 ronde <em>Gratis</em></span></label>
          <label class="opt"><input type="radio" name="rev" value="5" /><span>5 ronde <em>+Rp2,5jt · atau +Rp800rb kalau Fleksibel</em></span></label>
        </div>
      </div>

      <div class="est-block">
        <p class="est-label">Timeline</p>
        <div class="opt-row">
          <label class="opt"><input type="radio" name="speed" value="0.9" data-name="Fleksibel −10%" /><span>Fleksibel <em>−10%</em></span></label>
          <label class="opt"><input type="radio" name="speed" value="1" data-name="Standar" checked /><span>Standar <em>×1</em></span></label>
          <label class="opt"><input type="radio" name="speed" value="1.3" data-name="Kilat +30%" /><span>Kilat <em>+30%</em></span></label>
        </div>
      </div>

      <div class="est-result">
        <div class="bd">
          <div class="bd-row"><span>Tipe proyek</span><b id="bd-types">1 tipe · Rp 8 jt</b></div>
          <div class="bd-row" id="bd-save-row" style="display:none"><span>Hemat bundle</span><b id="bd-save" class="save">−Rp 0</b></div>
          <div class="bd-row"><span>Fitur</span><b id="bd-feat">Gratis</b></div>
          <div class="bd-row"><span>Revisi</span><b id="bd-rev">Gratis</b></div>
          <div class="bd-row"><span>Timeline</span><b id="bd-speed">Standar</b></div>
        </div>
        <div class="res-total">
          <span class="res-label">Harga terkuncimu</span>
          <span class="res-num" id="est-total">Rp 8 jt</span>
          <div class="res-actions">
            <button class="btn-outline" id="est-copy" type="button"><span class="copy-label">Salin quote</span></button>
            <a href="/id/contacts" class="btn-lemon">Ajukan scope ini</a>
          </div>
        </div>
      </div>
      <p class="est-note">Harga ini terkunci. Kirim ke saya dan segitu bayarnya, tanpa perubahan. Gabung tipe nge-share discovery, desain dan setup, dari situ diskon bundle berasal.</p>
    </div>

    <script>
      (function () {
        var root = document.getElementById('estimator');
        if (!root) return;
        function fmt(n) { return 'Rp ' + n.toLocaleString('id-ID'); }
        function set(id, text) { document.getElementById(id).textContent = text; }
        function short(n) {
          if (n >= 1000000 && n % 1000000 === 0) return 'Rp ' + (n / 1000000) + ' jt';
          if (n >= 1000000) return 'Rp ' + (n / 1000000).toLocaleString('id-ID', { maximumFractionDigits: 1 }) + ' jt';
          return fmt(n);
        }
        function detailLine(label, value, detail) {
          if (detail === 'none') return label + ': ' + value;
          return value === 'Gratis' ? label + ': ' + detail : label + ' (' + value + '): ' + detail;
        }
        function val(id) { return document.getElementById(id).textContent; }
        function recalc() {
          // Logika bundle: tipe termahal full, ke-2 −15%, ke-3+ −25% (setup bareng).
          var bases = [];
          root.querySelectorAll('input[name="ptype"]:checked').forEach(function (el) { bases.push(+el.value); });
          bases.sort(function (a, b) { return b - a; });
          var full = bases.reduce(function (s, v) { return s + v; }, 0);
          var disc = bases.reduce(function (s, v, i) { return s + v * (i === 0 ? 1 : (i === 1 ? 0.85 : 0.75)); }, 0);
          var saving = Math.round(full - disc);

          var feat = 0;
          root.querySelectorAll('input[name="feat"]:checked').forEach(function (el) { feat += +el.value; });

          var speed = root.querySelector('input[name="speed"]:checked');
          var mult = +speed.value;

          // 5 ronde revisi murah kalau jadwal longgar.
          var rev = +root.querySelector('input[name="rev"]:checked').value;
          var revCost = rev === 5 ? (mult === 0.9 ? 800000 : 2500000) : 0;

          set('bd-types', bases.length ? bases.length + (bases.length > 1 ? ' tipe · ' : ' tipe · ') + short(full) : '—');
          var saveRow = document.getElementById('bd-save-row');
          if (saving > 0) { saveRow.style.display = ''; set('bd-save', '−' + short(saving)); }
          else { saveRow.style.display = 'none'; }
          set('bd-feat', feat ? short(feat) : 'Gratis');
          set('bd-rev', revCost ? short(revCost) : 'Gratis');
          set('bd-speed', speed.dataset.name);
          // Total diskon nggak pernah dibulatkan: yang kelihatan ya yang dibayar.
          var raw = (disc + feat + revCost) * mult;
          var discounted = saving > 0 || mult < 1 || revCost === 800000;
          var total = discounted ? Math.round(raw) : (function () {
            var step = raw < 1000000 ? 10000 : 50000;
            return Math.round(raw / step) * step;
          })();
          set('est-total', fmt(total));
        }
        function picked(name) {
          var items = [];
          root.querySelectorAll('input[name="' + name + '"]:checked').forEach(function (el) {
            var label = el.parentElement.querySelector('span');
            if (label) items.push(label.innerText.replace(/\s+/g, ' ').trim());
          });
          return items.length ? items.join(', ') : 'none';
        }
        root.querySelectorAll('input').forEach(function (el) { el.addEventListener('change', recalc); });
        recalc();

        var copyBtn = document.getElementById('est-copy');
        if (copyBtn) {
          copyBtn.addEventListener('click', async function () {
            var saveRow = document.getElementById('bd-save-row');
            var text =
              'Quote terkunci saya dari jiilan.me/id/pricing: ' + val('est-total') + '\n' +
              'Tipe proyek (' + val('bd-types') + '): ' + picked('ptype') + '\n' +
              (saveRow.style.display !== 'none' ? 'Hemat bundle: ' + val('bd-save') + '\n' : '') +
              detailLine('Fitur', val('bd-feat'), picked('feat')) + '\n' +
              detailLine('Revisi', val('bd-rev'), picked('rev')) + '\n' +
              'Timeline: ' + picked('speed');
            try {
              await navigator.clipboard.writeText(text);
            } catch (e) {
              var ta = document.createElement('textarea');
              ta.value = text;
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }
            var label = copyBtn.querySelector('.copy-label');
            if (label) {
              var original = label.textContent;
              label.textContent = 'Tersalin! Kirim ke saya.';
              setTimeout(function () { label.textContent = original; }, 2500);
            }
          });
        }
      })();
    </script>

    <div class="custom reveal">
      <div>
        <span class="custom-tag">Sistem ERP dan produk SaaS</span>
        <h2>Sistem gede? Quote individual.</h2>
        <p>Ceritain software-nya harus bisa apa. Kamu dapet plan dan harga pasti sebelum mulai.</p>
      </div>
      <a href="/id/contacts" class="btn-lemon">Hubungi saya</a>
    </div>

    <p class="fine reveal">Semua harga dalam IDR. Angka tier itu starting point. Harga estimator terkunci: salin, kirim, segitu bayarnya.</p>
  </section>
</Layout>

<style>
  .page { max-width: var(--page-width); margin: 0 auto; padding: var(--space-4) var(--space-3) var(--space-8); }

  .kicker {
    display: inline-block; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    background: var(--color-lemon); border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill); padding: 6px 14px; margin-bottom: var(--space-2);
  }

  .page-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: var(--text-4xl); letter-spacing: -0.03em; line-height: 1.05;
  }

  .page-sub { color: var(--color-muted); font-size: var(--text-lg); margin-top: 10px; max-width: 60ch; }

  .grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px; margin-top: var(--space-3);
  }

  .card {
    border: 2px solid var(--color-ink); border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-2); display: flex; flex-direction: column; gap: 8px;
    transition: transform var(--duration) var(--ease);
  }

  .card:hover { transform: translateY(-3px); }

  .tag {
    align-self: flex-start; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    border: 2px solid currentColor; border-radius: var(--radius-pill); padding: 4px 12px;
    background: var(--color-paper-2);
  }

  .starts { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-muted); }

  .price {
    font-family: var(--font-display); font-weight: 700;
    font-size: var(--text-3xl); letter-spacing: -0.03em; line-height: 1;
  }

  .typical { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; color: var(--color-accent); }

  .card ul { list-style: none; display: flex; flex-direction: column; gap: 6px; margin-top: 4px; }

  .card li {
    font-size: var(--text-base); padding-left: 26px; position: relative;
  }

  .card li::before {
    content: '✓'; position: absolute; left: 0;
    font-family: var(--font-mono); font-weight: 700; color: var(--color-success);
  }

  .card-cta { margin-top: auto; padding-top: 8px; font-weight: 700; color: var(--color-ink); }
  .card-cta:hover { color: var(--color-accent); }

  .estimator {
    margin-top: 12px; background: var(--color-paper-2);
    border: 2px solid var(--color-ink); border-radius: 28px; padding: var(--space-4);
    box-shadow: var(--shadow-card);
  }

  .estimator h2 {
    font-family: var(--font-display); font-weight: 700;
    font-size: var(--text-2xl); letter-spacing: -0.02em;
    margin: 10px 0 6px;
  }

  .est-sub { color: var(--color-muted); }

  .est-block { margin-top: var(--space-3); }

  .est-label {
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    color: var(--color-muted); margin-bottom: 10px;
  }

  .opt-row { display: flex; flex-wrap: wrap; gap: 8px; }

  .opt { position: relative; }

  .opt input { position: absolute; opacity: 0; pointer-events: none; }

  .opt span {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-body); font-size: var(--text-sm); font-weight: 700;
    color: var(--color-ink); background: var(--color-paper);
    border: 2px solid var(--color-ink); border-radius: var(--radius-pill);
    padding: 9px 16px; white-space: nowrap;
    transition: transform var(--duration) var(--ease), background var(--duration) var(--ease), color var(--duration) var(--ease);
  }

  .opt span em { font-style: normal; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-muted); }

  .opt span:hover { transform: translateY(-2px); }

  .opt input:checked + span {
    background: var(--color-ink); color: var(--color-paper);
    box-shadow: 3px 3px 0 var(--color-accent);
  }

  .opt input:checked + span em { color: var(--color-lemon); }

  .opt input:focus-visible + span { outline: 3px solid var(--color-accent); outline-offset: 2px; }

  .free {
    font-style: normal; font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: #ffffff; background: var(--color-success);
    border-radius: var(--radius-pill); padding: 3px 10px;
  }

  .est-result {
    margin-top: var(--space-3); background: var(--color-ink); color: var(--color-paper);
    border-radius: var(--radius-card); padding: var(--space-3);
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
  }

  .bd { display: flex; flex-direction: column; gap: 6px; min-width: 0; }

  .bd-row {
    display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-xs);
  }

  .bd-row span { color: var(--color-paper); opacity: 0.65; white-space: nowrap; }
  .bd-row b { color: var(--color-paper); font-weight: 600; text-align: right; }
  .bd-row b.save { color: var(--color-mint-deep); }

  .res-total {
    display: flex; flex-direction: column; align-items: flex-end; gap: 10px;
    flex: none; text-align: right;
  }

  .res-label {
    display: block; font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--color-paper); opacity: 0.7;
  }

  .res-num {
    display: block; font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.5rem, 4vw, 2.25rem); letter-spacing: -0.03em; line-height: 1.1;
    color: var(--color-lemon); overflow-wrap: anywhere;
  }

  .est-note {
    margin-top: 12px; font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .custom {
    margin-top: 12px; background: var(--color-ink); color: var(--color-paper);
    border: 2px solid var(--color-ink); border-radius: 28px; padding: var(--space-4);
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    box-shadow: 6px 6px 0 var(--color-accent);
  }

  .custom-tag {
    display: inline-block; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    background: var(--color-lemon); color: var(--color-ink);
    border-radius: var(--radius-pill); padding: 4px 12px; margin-bottom: 10px;
  }

  .custom h2 {
    font-family: var(--font-display); font-weight: 700;
    font-size: var(--text-2xl); letter-spacing: -0.02em;
  }

  .custom p { opacity: 0.75; margin-top: 8px; max-width: 52ch; }

  .btn-lemon {
    flex: none; font-family: var(--font-body); font-size: var(--text-base); font-weight: 700;
    color: var(--color-ink); background: var(--color-lemon);
    border: 2px solid var(--color-paper); border-radius: var(--radius-pill);
    padding: 13px 24px; white-space: nowrap;
    transition: transform var(--duration) var(--ease);
  }

  .btn-lemon:hover { transform: translateY(-2px) rotate(1deg); }
  .btn-lemon:active { transform: translateY(1px) scale(0.98); }

  .res-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }

  .btn-outline {
    font-family: var(--font-body); font-size: var(--text-base); font-weight: 700;
    color: var(--color-paper); background: transparent;
    border: 2px solid var(--color-paper); border-radius: var(--radius-pill);
    padding: 13px 24px; white-space: nowrap;
    transition: transform var(--duration) var(--ease), background var(--duration) var(--ease);
  }

  .btn-outline:hover { background: rgba(250, 250, 246, 0.12); transform: translateY(-2px); }
  .btn-outline:active { transform: translateY(1px) scale(0.98); }
  .btn-outline .copy-label { pointer-events: none; }

  .fine {
    margin-top: var(--space-3); font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--color-muted); max-width: 70ch;
  }

  @media (max-width: 768px) {
    .page { padding: var(--space-3) var(--space-2) var(--space-6); }
    .page-title { font-size: var(--text-3xl); }
    .grid { grid-template-columns: minmax(0, 1fr); }
    .custom, .est-result { flex-direction: column; align-items: flex-start; }
    .res-total { align-items: flex-start; text-align: left; }
  }
</style>
