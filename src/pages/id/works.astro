---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="id" alternate="/works" title="Karya — Jiilan Nashrulloh Tanjung" description="Karya pilihan Jiilan Nashrulloh Tanjung: website, aplikasi mobile dan otomasi AI.">
  <section class="page">
    <header class="page-head reveal">
      <h1 class="page-title">Karya</h1>
      <p class="page-sub">Beberapa hal yang sudah saya buat dan launch. Terbaru dulu.</p>
    </header>

    <div class="work-list reveal">
      <a class="work-row" href="https://github.com/JiilanTj" target="_blank" rel="noopener noreferrer">
        <span class="work-index">01</span>
        <span class="work-main">
          <span class="work-tag">Web</span>
          <span class="work-title">Website Bisnis + Dashboard</span>
          <span class="work-desc">Company site cepat dengan dashboard simpel buat kelola konten dan pantau leads.</span>
          <span class="work-stack">Next.js · Tailwind · PostgreSQL</span>
        </span>
        <span class="work-arrow" aria-hidden="true">→</span>
      </a>

      <a class="work-row" href="https://github.com/JiilanTj" target="_blank" rel="noopener noreferrer">
        <span class="work-index">02</span>
        <span class="work-main">
          <span class="work-tag">Mobile</span>
          <span class="work-title">Aplikasi Mobile Cross-Platform</span>
          <span class="work-desc">Satu codebase jalan di iOS dan Android, dari sketsa pertama sampai rilis store.</span>
          <span class="work-stack">React Native · Expo · Node.js</span>
        </span>
        <span class="work-arrow" aria-hidden="true">→</span>
      </a>

      <a class="work-row" href="https://github.com/JiilanTj" target="_blank" rel="noopener noreferrer">
        <span class="work-index">03</span>
        <span class="work-main">
          <span class="work-tag">Otomasi</span>
          <span class="work-title">Otomasi Lead dan Workflow AI</span>
          <span class="work-desc">Chatbot dan integrasi yang nangkap leads dan sinkronin tools selagi tim tidur.</span>
          <span class="work-stack">Python · OpenAI API · Integrasi</span>
        </span>
        <span class="work-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .page { max-width: var(--page-width); margin: 0 auto; padding: var(--space-4) var(--space-3) var(--space-8); }
  .page-head { margin-bottom: var(--space-3); }
  .page-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: var(--text-4xl); letter-spacing: -0.03em; line-height: 1.05;
  }
  .page-sub { color: var(--color-muted); font-size: var(--text-lg); margin-top: 10px; max-width: 56ch; }

  .work-list {
    margin-top: var(--space-3);
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: 28px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .work-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 56px;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-3);
    border-top: 2px dashed var(--color-line);
    transition: background var(--duration) var(--ease);
  }

  .work-row:first-child { border-top: none; }
  .work-row:hover { background: var(--color-cream); }
  .work-row:active { transform: scale(0.995); }

  .work-index {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .work-main { display: flex; flex-direction: column; gap: 6px; min-width: 0; }

  .work-tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-lemon);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 2px 12px;
  }

  .work-row:nth-child(2) .work-tag { background: var(--color-sky-deep); }
  .work-row:nth-child(3) .work-tag { background: var(--color-peach-deep); }

  .work-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .work-row:hover .work-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }

  .work-desc { color: var(--color-muted); }

  .work-stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .work-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-paper);
    border: 2px solid var(--color-ink);
    font-weight: 700;
    font-size: var(--text-lg);
    transition: transform var(--duration) var(--ease), background var(--duration) var(--ease), color var(--duration) var(--ease);
  }

  .work-row:hover .work-arrow {
    transform: rotate(-45deg);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  @media (max-width: 768px) {
    .page { padding: var(--space-3) var(--space-2) var(--space-6); }
    .page-title { font-size: var(--text-3xl); }
    .work-row { grid-template-columns: 40px minmax(0, 1fr) 48px; padding: var(--space-2); }
    .work-title { font-size: var(--text-lg); }
    .work-arrow { width: 40px; height: 40px; }
  }
</style>
