---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="id" title="Nyasar? — Jiilan Nashrulloh Tanjung" description="Halaman tidak ditemukan.">
  <section class="page">
    <div class="card">
      <span class="kicker">404</span>
      <h1 class="title">Halaman ini nyasar.</h1>
      <p class="sub">Nggak ada atau sudah pindah. Balik yuk.</p>
      <a href="/id/" class="btn">Balik ke home</a>
    </div>
  </section>
</Layout>

<style>
  .page { max-width: var(--page-width); margin: 0 auto; padding: var(--space-6) var(--space-3) var(--space-8); }
  .card {
    max-width: 560px; margin: 0 auto; text-align: center;
    background: var(--color-paper-2); border: 2px solid var(--color-ink);
    border-radius: 28px; padding: var(--space-6) var(--space-4);
    box-shadow: var(--shadow-card);
  }
  .kicker {
    display: inline-block; font-family: var(--font-mono); font-weight: 600;
    background: var(--color-lemon); border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill); padding: 6px 16px; margin-bottom: var(--space-2);
  }
  .title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-3xl); letter-spacing: -0.03em; }
  .sub { color: var(--color-muted); margin: 10px 0 var(--space-3); }
  .btn {
    display: inline-block; font-weight: 700; color: var(--color-paper);
    background: var(--color-ink); border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill); padding: 12px 24px;
    box-shadow: 3px 3px 0 var(--color-accent);
  }
  .btn:hover { transform: translateY(-2px); }
</style>
