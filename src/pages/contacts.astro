---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacts — Jiilan Nashrulloh Tanjung">
  <section class="contacts-page">
    <header class="page-header">
      <h1 class="page-title">Contacts</h1>
      <p class="page-subtitle">Reach out. I read everything.</p>
      <hr class="page-rule" />
    </header>

    <div class="contacts-content">
      <div class="contact-channels">
        <div class="contact-item">
          <span class="contact-label">EMAIL</span>
          <a href="mailto:jiilannashrulloh@gmail.com" class="contact-value">jiilannashrulloh@gmail.com</a>
        </div>

        <div class="contact-item">
          <span class="contact-label">GITHUB</span>
          <a href="https://github.com/JiilanTj" class="contact-value" target="_blank" rel="noopener noreferrer">github.com/JiilanTj</a>
        </div>
      </div>

      <div class="contact-note">
        <p class="note-text">
          For research collaborations, technical discussions, or anything that
          requires more than a tweet — email is the way to go.
          I try to respond within a few days.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contacts-page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
    padding-top: calc(var(--space-12) + 64px);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .page-subtitle {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    margin-top: var(--space-1);
  }

  .page-rule {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin-top: var(--space-4);
  }

  .contacts-content {
    max-width: var(--content-width);
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .contact-item {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color var(--duration-md) var(--ease);
  }

  .contact-item:hover {
    border-color: var(--color-accent);
  }

  .contact-label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--color-text-ghost);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: var(--space-1);
  }

  .contact-value {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-accent);
    transition: opacity var(--duration) var(--ease);
  }

  .contact-value:hover {
    opacity: 0.8;
  }

  .contact-note {
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-3);
  }

  .note-text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .contacts-page {
      padding: var(--space-8) var(--space-3);
      padding-top: calc(var(--space-8) + 64px);
    }
  }
</style>
