---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Say hello — Jiilan Nashrulloh Tanjung" description="Contact Jiilan Nashrulloh Tanjung for collaboration and consulting.">
  <section class="page">
    <header class="head reveal">
      <h1 class="title">Say hello.</h1>
      <p class="sub">For collaboration, consulting or a good technical argument. I read everything.</p>
    </header>

    <div class="grid">
      <a href="mailto:jiilannashrulloh@gmail.com" class="channel channel-lemon reveal">
        <span class="label">Email</span>
        <span class="value">jiilannashrulloh@gmail.com</span>
        <span class="hint">Replies within a few days →</span>
      </a>
      <a href="https://github.com/JiilanTj" target="_blank" rel="noopener noreferrer" class="channel channel-ink reveal">
        <span class="label">GitHub</span>
        <span class="value">github.com/JiilanTj</span>
        <span class="hint">Code and experiments →</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .page { max-width: var(--page-width); margin: 0 auto; padding: var(--space-4) var(--space-3) var(--space-8); }
  .title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-4xl); letter-spacing: -0.03em; line-height: 1.05; }
  .sub { color: var(--color-muted); font-size: var(--text-lg); margin-top: 10px; max-width: 52ch; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; margin-top: var(--space-3); }
  .channel {
    border: 2px solid var(--color-ink); border-radius: var(--radius-card);
    padding: var(--space-3); display: flex; flex-direction: column; gap: 8px;
    transition: transform var(--duration) var(--ease);
  }
  .channel:hover { transform: translateY(-3px) rotate(-0.4deg); }
  .channel-lemon { background: var(--color-lemon); }
  .channel-ink { background: var(--color-ink); color: var(--color-paper); }
  .label { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; opacity: 0.7; }
  .value { font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl); letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .hint { font-size: var(--text-sm); font-weight: 600; }
  .channel-lemon .hint { color: var(--color-accent); }
  .channel-ink .hint { color: var(--color-lemon); }
  @media (max-width: 768px) {
    .page { padding: var(--space-3) var(--space-2) var(--space-6); }
    .grid { grid-template-columns: minmax(0, 1fr); }
    .title { font-size: var(--text-3xl); }
  }
</style>
