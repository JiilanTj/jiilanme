---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Works — Jiilan Nashrulloh Tanjung" description="Selected work by Jiilan Nashrulloh Tanjung: websites, mobile apps and AI automation.">
  <section class="page">
    <header class="page-head reveal">
      <h1 class="page-title">Works</h1>
      <p class="page-sub">A few things I've built and shipped.</p>
    </header>

    <div class="grid">
      <article class="card card-ink reveal">
        <span class="tag">Web</span>
        <h2>Business Website + Dashboard</h2>
        <p>A fast company site with a simple dashboard to manage content and track leads.</p>
        <a href="https://github.com/JiilanTj" target="_blank" rel="noopener noreferrer">View on GitHub →</a>
      </article>

      <article class="card card-mint reveal">
        <span class="tag">Mobile</span>
        <h2>Cross-Platform Mobile App</h2>
        <p>One codebase running on iOS and Android, from first sketch to store release.</p>
        <a href="https://github.com/JiilanTj" target="_blank" rel="noopener noreferrer">View on GitHub →</a>
      </article>

      <article class="card card-sky reveal">
        <span class="tag">Automation</span>
        <h2>AI Lead and Workflow Automation</h2>
        <p>Chatbots and integrations that capture leads and sync your tools while the team sleeps.</p>
        <a href="https://github.com/JiilanTj" target="_blank" rel="noopener noreferrer">View on GitHub →</a>
      </article>
    </div>
  </section>
</Layout>

<style>
  .page { max-width: var(--page-width); margin: 0 auto; padding: var(--space-4) var(--space-3) var(--space-8); }
  .page-head { margin-bottom: var(--space-3); }
  .page-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: var(--text-4xl); letter-spacing: -0.03em; line-height: 1.05;
  }
  .page-sub { color: var(--color-muted); font-size: var(--text-lg); margin-top: 10px; max-width: 56ch; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr); gap: 12px; margin-top: var(--space-3); }
  .card {
    border: 2px solid var(--color-ink); border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-2); display: flex; flex-direction: column; gap: 10px;
    transition: transform var(--duration) var(--ease);
  }
  .card:hover { transform: translateY(-3px); }
  .card h2 { font-family: var(--font-display); font-size: var(--text-xl); letter-spacing: -0.02em; line-height: 1.25; overflow-wrap: anywhere; }
  .card p { color: var(--color-muted); }
  .card-ink { background: var(--color-ink); color: var(--color-paper); }
  .card-ink p { opacity: 0.75; }
  .card-ink a { color: var(--color-lemon); font-weight: 700; }
  .card-mint { background: var(--color-mint); }
  .card-sky { background: var(--color-sky); }
  .card a { font-weight: 700; color: var(--color-accent); }
  .tag {
    align-self: flex-start; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    border: 2px solid currentColor; border-radius: var(--radius-pill); padding: 4px 12px;
  }
  @media (max-width: 768px) {
    .page { padding: var(--space-3) var(--space-2) var(--space-6); }
    .grid { grid-template-columns: minmax(0, 1fr); }
    .page-title { font-size: var(--text-3xl); }
  }
</style>
