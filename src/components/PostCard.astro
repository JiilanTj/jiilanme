---
interface Props {
  title: string;
  date: string;
  readTime: string;
  slug: string;
  index?: number;
}

const { title, date, readTime, slug, index = 0 } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const delay = `${Math.min(index, 6) * 60}ms`;
---

<a href={`/writing/${slug}`} class="post-card" style={`animation-delay: ${delay}`}>
  <span class="post-arrow" aria-hidden="true">→</span>
  <span class="post-body">
    <span class="post-card-title">{title}</span>
    <span class="post-card-meta">
      <span>{formattedDate}</span>
      <span class="meta-dot" aria-hidden="true"></span>
      <span>{readTime}</span>
    </span>
  </span>
</a>

<style>
  .post-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2);
    background: var(--color-paper-2);
    border: 2px solid var(--color-line);
    border-radius: var(--radius-card);
    animation: rise-in var(--duration-lg) var(--ease) both;
    transition: transform var(--duration) var(--ease), border-color var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
  }

  .post-card:hover {
    transform: translateY(-3px) rotate(-0.3deg);
    border-color: var(--color-ink);
    box-shadow: var(--shadow-card);
  }

  .post-card:active {
    transform: translateY(1px) scale(0.99);
  }

  .post-arrow {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-lemon);
    border: 2px solid var(--color-ink);
    font-weight: 700;
    transition: background var(--duration) var(--ease), transform var(--duration) var(--ease);
  }

  .post-card:hover .post-arrow {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    transform: rotate(-12deg);
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .post-card-title {
    font-family: var(--font-display);
    font-style: normal;
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .post-card-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .meta-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }
</style>
