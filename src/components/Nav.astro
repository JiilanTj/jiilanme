---
import { ID_ENABLED, toCounterpart, type Locale } from '../i18n/config';
import { dict } from '../i18n/dict';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = dict[lang];

const pathname = Astro.url.pathname;
// Strip /id prefix so active states work in both locales.
const base = pathname.replace(/^\/id(?=\/|$)/, '') || '/';

function isActive(href: string): boolean {
  if (href === '/') return base === '/';
  return base.startsWith(href);
}

// Prefix internal links when rendering the Indonesian locale.
function p(href: string): string {
  if (lang !== 'id') return href;
  return href === '/' ? '/id/' : `/id${href}`;
}
---

<nav class="nav" id="site-nav" aria-label="Primary">
  <div class="nav-inner">
    <a href={p('/')} class="nav-logo" aria-label="Jiilan home">
      <span class="logo-mark" aria-hidden="true">J</span>
      <span class="logo-text">jiilan.me</span>
    </a>
    <div class="nav-links">
      <a href={p('/works')} class:list={["nav-link", { "is-active": isActive("/works") }]}>{t.works}</a>
      <a href={p('/writing')} class:list={["nav-link", { "is-active": isActive("/writing") }]}>{t.writing}</a>
      <a href={p('/research')} class:list={["nav-link", { "is-active": isActive("/research") }]}>{t.research}</a>
      <a href={p('/about')} class:list={["nav-link", { "is-active": isActive("/about") }]}>{t.about}</a>
      <a href={p('/pricing')} class:list={["nav-link", { "is-active": isActive("/pricing") }]}>{t.pricing}</a>
    </div>
    <div class="nav-right">
      <div class="locale-switch" role="group" aria-label="Language / Bahasa">
        {lang === 'en'
          ? <span class="loc loc-active" aria-current="true">EN</span>
          : <a class="loc" href={toCounterpart(pathname, 'en')} onclick="try{localStorage.setItem('locale','en')}catch(e){}">EN</a>}
        {ID_ENABLED
          ? (lang === 'id'
            ? <span class="loc loc-active" aria-current="true">ID</span>
            : <a class="loc" href={toCounterpart(pathname, 'id')} onclick="try{localStorage.setItem('locale','id')}catch(e){}">ID</a>)
          : <span class="loc loc-soon" title="Versi Indonesia segera hadir">ID</span>}
      </div>
      <a href={p('/contacts')} class="nav-cta">{t.sayHello}</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 12px;
    z-index: 100;
    max-width: var(--page-width);
    margin: 12px auto 0;
    padding: 0 var(--space-3);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    min-height: 64px;
    padding: 10px 10px 10px 16px;
    background: var(--color-paper-2);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-card);
  }

  .nav-logo { justify-self: start; }
  .nav-links { justify-self: center; }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-self: end;
    min-width: 0;
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-ink);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: var(--text-base);
    transform: rotate(-6deg);
  }

  .logo-text {
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 4px;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: background var(--duration) var(--ease), color var(--duration) var(--ease), transform var(--duration) var(--ease);
  }

  .nav-link:hover {
    color: var(--color-ink);
    background: var(--color-cream);
  }

  .nav-link:active {
    transform: translateY(1px) scale(0.98);
  }

  .nav-link.is-active {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .locale-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 2px;
    flex: none;
  }

  .loc {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-muted);
    padding: 4px 8px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  a.loc:hover {
    background: var(--color-cream);
    color: var(--color-ink);
  }

  .loc-active {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .loc-soon {
    opacity: 0.45;
    border: 1px dashed var(--color-faint);
    cursor: not-allowed;
  }

  .nav-cta {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 10px 18px;
    white-space: nowrap;
    box-shadow: 3px 3px 0 var(--color-ink);
    transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
  }

  .nav-cta:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--color-ink);
  }

  .nav-cta:active {
    transform: translateY(1px) scale(0.98);
    box-shadow: 1px 1px 0 var(--color-ink);
  }

  @media (max-width: 768px) {
    .nav {
      top: 8px;
      margin-top: 8px;
      padding: 0 var(--space-2);
    }

    .nav-inner {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        "logo right"
        "links links";
      min-height: 0;
      padding: 10px 10px 10px 12px;
      gap: 8px;
      border-radius: 22px;
    }

    .nav-logo { grid-area: logo; }
    .nav-right { grid-area: right; }
    .nav-links { grid-area: links; }

    .logo-text { display: none; }

    .nav-links {
      flex: 1;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav-links::-webkit-scrollbar { display: none; }

    .nav-link {
      padding: 8px 12px;
      font-size: var(--text-sm);
    }

    .nav-cta {
      padding: 9px 14px;
    }

    /* Folded: links row collapses, leaving a mini bar */
    .nav-links {
      max-height: 60px;
      transition: max-height 300ms var(--ease), opacity 250ms ease, padding 300ms var(--ease);
    }

    .nav--scrolled .nav-inner {
      gap: 0;
    }

    .nav--scrolled .nav-links {
      max-height: 0;
      opacity: 0;
      padding-top: 0;
      padding-bottom: 0;
      overflow: hidden;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links {
      transition: none;
    }
  }
</style>

<script>
  // Mobile only: fold the menu row on scroll down, unfold on scroll up.
  // Desktop nav stays static. Disabled entirely under reduced motion.
  const nav = document.getElementById('site-nav');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.matchMedia('(max-width: 768px)');
  if (nav && !reduceMotion) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!isMobile.matches) {
        nav.classList.remove('nav--scrolled');
        lastY = window.scrollY;
        return;
      }
      const y = window.scrollY;
      if (y <= 80) {
        nav.classList.remove('nav--scrolled');
      } else if (y > lastY + 4 && y > 200) {
        nav.classList.add('nav--scrolled');
      } else if (y < lastY - 4) {
        nav.classList.remove('nav--scrolled');
      }
      lastY = y;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>
