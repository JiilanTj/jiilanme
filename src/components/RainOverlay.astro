<div class="rain-overlay" aria-hidden="true">
  {Array.from({ length: 50 }).map((_, i) => (
    <div class="raindrop" style={`left: ${Math.random() * 100}%; animation-delay: ${Math.random() * 4}s; animation-duration: ${1.3 + Math.random() * 1.8}s; opacity: ${0.1 + Math.random() * 0.18};`} />
  ))}
</div>

<style>
  .rain-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9998;
    overflow: hidden;
  }

  .raindrop {
    position: absolute;
    top: -20px;
    width: 1px;
    height: 45px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(130, 155, 200, 0.4) 40%,
      rgba(130, 155, 200, 0.1) 100%
    );
    animation: rain-fall linear infinite;
  }

  @keyframes rain-fall {
    0% {
      transform: translateY(-40px);
    }
    100% {
      transform: translateY(calc(100vh + 40px));
    }
  }
</style>
