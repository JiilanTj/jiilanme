---
import type { Locale } from '../i18n/config';
import { dict } from '../i18n/dict';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = dict[lang];
const p = (href: string): string => (lang !== 'id' ? href : href === '/' ? '/id/' : `/id${href}`);

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-card">
    <div class="footer-top">
      <p class="footer-cta-title">{t.footerCta}</p>
      <a href={p('/contacts')} class="footer-cta">{t.sayHello}</a>
    </div>
    <div class="footer-bottom">
      <span class="footer-meta">© {year} Jiilan Nashrulloh Tanjung</span>
      <div class="footer-links">
        <a href={p('/pricing')}>{t.pricing}</a>
        <a href="https://github.com/JiilanTj" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:jiilannashrulloh@gmail.com">Email</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-3) var(--space-4);
  }

  .footer-card {
    background: var(--color-ink);
    color: var(--color-paper);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    box-shadow: var(--shadow-card);
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid rgba(250, 250, 246, 0.16);
  }

  .footer-cta-title {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 22ch;
    overflow-wrap: anywhere;
  }

  .footer-cta {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-ink);
    background: var(--color-lemon);
    border-radius: var(--radius-pill);
    padding: 12px 22px;
    white-space: nowrap;
    border: 2px solid var(--color-paper);
    transition: transform var(--duration) var(--ease);
  }

  .footer-cta:hover { transform: translateY(-2px) rotate(-1deg); }
  .footer-cta:active { transform: translateY(1px) scale(0.98); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .footer-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-paper);
    opacity: 0.7;
  }

  .footer-links {
    display: flex;
    gap: var(--space-2);
  }

  .footer-links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-paper);
    opacity: 0.85;
    white-space: nowrap;
  }

  .footer-links a:hover {
    color: var(--color-lemon);
    opacity: 1;
  }

  @media (max-width: 768px) {
    .footer { padding: var(--space-4) var(--space-2) var(--space-3); }
    .footer-card { padding: var(--space-3); }
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
