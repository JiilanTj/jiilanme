---
import Layout from './Layout.astro';
import PostHeader from '../components/PostHeader.astro';

interface Props {
  title: string;
  date: string;
  readTime: string;
  category: string;
  description: string;
  slug: string;
}

const { title, date, readTime, category, description, slug } = Astro.props;

const articleUrl = `https://jiilan.me/writing/${slug}`;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": title,
  "author": {
    "@type": "Person",
    "name": "Jiilan Nashrulloh Tanjung",
    "url": "https://jiilan.me"
  },
  "datePublished": date,
  "dateModified": date,
  "description": description,
  "url": articleUrl,
  "publisher": {
    "@type": "Person",
    "name": "Jiilan Nashrulloh Tanjung"
  },
  "inLanguage": "en",
  "about": [category]
});
---

<Layout title={`${title} — Jiilan Nashrulloh Tanjung`} description={description} ogType="article">
  <script type="application/ld+json" set:html={jsonLd} />
  <article class="post-page">
    <PostHeader title={title} date={date} readTime={readTime} category={category} />

    <div class="prose">
      <slot />
    </div>

    <hr class="post-end-rule" />

    <div class="share-row">
      <span class="share-label">SHARE</span>
      <div class="share-buttons">
        <a class="share-btn" id="share-x" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a class="share-btn" id="share-linkedin" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <button class="share-btn" id="share-copy" aria-label="Copy link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span class="copy-label">Copy link</span>
        </button>
      </div>
    </div>

    <a href="/writing" class="back-link">← All writing</a>
  </article>
</Layout>

<script>
  const url = encodeURIComponent(window.location.href);
  const title = encodeURIComponent(document.title);

  const xBtn = document.getElementById('share-x') as HTMLAnchorElement;
  const liBtn = document.getElementById('share-linkedin') as HTMLAnchorElement;
  const copyBtn = document.getElementById('share-copy');

  if (xBtn) xBtn.href = `https://x.com/intent/tweet?url=${url}&text=${title}`;
  if (liBtn) liBtn.href = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const label = copyBtn.querySelector('.copy-label');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = original; }, 2000);
        }
      } catch {}
    });
  }
</script>

<style>
  .post-page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-3);
    padding-top: calc(var(--space-12) + 64px);
  }

  .post-end-rule {
    border: none;
    height: 1px;
    background: #1f1f1f;
    margin: var(--space-8) 0 var(--space-4) 0;
  }

  .back-link {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration) var(--ease);
    display: inline-block;
    padding-bottom: var(--space-8);
  }

  .back-link:hover {
    color: var(--color-text);
  }

  /* ── Share Row ── */
  .share-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .share-label {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    color: var(--color-text-ghost);
    letter-spacing: 0.1em;
  }

  .share-buttons {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    cursor: none;
    transition: color 180ms ease, border-color 180ms ease;
  }

  .share-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .copy-label {
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .post-page {
      padding: var(--space-6) var(--space-2);
      padding-top: calc(var(--space-8) + 64px);
    }

    .share-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }

    .share-btn {
      padding: 6px 10px;
    }
  }
</style>
